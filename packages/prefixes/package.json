{
  "name": "@ldforge/prefixes",
  "version": "0.1.10",
  "description": "Compact and extended RDF/SPARQL prefix catalogs with namespace search",
  "type": "module",
  "license": "EUPL-1.2",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "DATA.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./compact": {
      "types": "./dist/compact.d.ts",
      "import": "./dist/compact.js"
    },
    "./extended": {
      "types": "./dist/extended.d.ts",
      "import": "./dist/extended.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "preversion": "node ../../scripts/release.mjs reject-workspace"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mightymax/ldforge.git",
    "directory": "packages/prefixes"
  },
  "homepage": "https://github.com/mightymax/ldforge/tree/main/packages/prefixes#readme",
  "bugs": {
    "url": "https://github.com/mightymax/ldforge/issues"
  }
}
