{
  "name": "@ldforge/network",
  "version": "1.0.2",
  "description": "Lazy-loaded interactive network result renderer for LDForge",
  "keywords": [
    "ldforge",
    "sparql",
    "rdf",
    "linked-data",
    "semantic-web",
    "sparql-results",
    "data-visualization",
    "network",
    "graph",
    "vis-network"
  ],
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "preversion": "node ../../scripts/release.mjs reject-workspace"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ldforge/core": "^1.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mightymax/ldforge.git",
    "directory": "packages/network"
  },
  "homepage": "https://github.com/mightymax/ldforge/tree/main/packages/network#readme",
  "bugs": {
    "url": "https://github.com/mightymax/ldforge/issues"
  }
}
