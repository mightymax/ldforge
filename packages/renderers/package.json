{
  "name": "@ldforge/renderers",
  "version": "1.1.2",
  "description": "LDForge renderers: composable SPARQL tooling",
  "keywords": [
    "ldforge",
    "sparql",
    "rdf",
    "linked-data",
    "semantic-web",
    "sparql-results",
    "data-visualization",
    "table"
  ],
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "preversion": "node ../../scripts/release.mjs reject-workspace"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@ldforge/core": "^1.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mightymax/ldforge.git",
    "directory": "packages/renderers"
  },
  "homepage": "https://github.com/mightymax/ldforge/tree/main/packages/renderers#readme",
  "bugs": {
    "url": "https://github.com/mightymax/ldforge/issues"
  }
}
