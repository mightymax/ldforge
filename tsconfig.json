{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@ldforge/core": ["packages/core/src/index.ts"],
      "@ldforge/editor": ["packages/editor/src/index.ts"],
      "@ldforge/renderers": ["packages/renderers/src/index.ts"],
      "@ldforge/prefixes": ["packages/prefixes/src/index.ts"],
      "@ldforge/prefixes/*": ["packages/prefixes/src/*.ts"],
      "@ldforge/charts": ["packages/charts/src/index.ts"],
      "@ldforge/geo": ["packages/geo/src/index.ts"],
      "@ldforge/network": ["packages/network/src/index.ts"],
      "@ldforge/timeline": ["packages/timeline/src/index.ts"],
      "@ldforge/pivot": ["packages/pivot/src/index.ts"],
      "@ldforge/tree": ["packages/tree/src/index.ts"]
    },
    "types": ["node", "vite/client"]
  },
  "include": [
    "packages/**/*.ts",
    "apps/**/*.ts",
    "tests/**/*.ts",
    "e2e/**/*.ts",
    "*.ts"
  ]
}
